# RocketMQ Console 反向代理示例
# 放置到 /etc/nginx/conf.d/rocketmq-console.conf 后 nginx -t && nginx -s reload
# 证书路径按实际替换；仅允许内网/VPN 来源访问时可启用 allow/deny。

server {
    listen 80;
    server_name rocketmq-console.internal.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name rocketmq-console.internal.example.com;

    ssl_certificate     /etc/nginx/certs/rocketmq-console.crt;
    ssl_certificate_key /etc/nginx/certs/rocketmq-console.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    server_tokens       off;

    # 仅在确认该域名及其子域全部使用 HTTPS 后再启用 includeSubDomains。
    add_header Strict-Transport-Security "max-age=31536000" always;

    # 可选：只允许公司内网网段
    # allow 10.0.0.0/8;
    # allow 172.16.0.0/12;
    # allow 192.168.0.0/16;
    # deny all;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # 覆盖而不是追加，避免客户端伪造 X-Forwarded-For 绕过登录限流/污染审计 IP。
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
