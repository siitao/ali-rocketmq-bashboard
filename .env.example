# ===== 必填 =====
# 用来签名会话 Cookie，生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex

# 允许管理的 RocketMQ 实例 ID，多个用英文逗号分隔。
# 这是应用层白名单，即使 RAM 权限更大也只允许操作这里列出的实例。
ALLOWED_INSTANCE_IDS=rmq-cn-xxxxxxxx

# 实例所在地域
ALIYUN_REGION=cn-hangzhou

# 1 = 使用内存 Mock 数据（本地开发/演示，不访问阿里云）
MOCK_ALIYUN=0

# ===== 部署在阿里云 ECS 时无需配置 AK，自动使用 ECS RAM 角色 =====
# 非 ECS 环境本地调试时才需要下面两项；不要提交到仓库。
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ===== 可选 =====
# DATABASE_URL=sqlite:////data/app.db
# 反向代理已启用 HTTPS 时设为 true
COOKIE_SECURE=false
# SESSION_TTL_HOURS=8
# DEFAULT_MESSAGE_QUERY_MINUTES=30
# MAX_MESSAGE_QUERY_HOURS=24
# LOG_LEVEL=INFO
